<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.blicca.referencelist">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Collective Blicca Referencelist"
      description="Aurora Reference List block: picked content items rendered like a listing, with per-variation templates and item templates"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Blicca Referencelist (uninstall)"
      description="Uninstalls collective.blicca.referencelist"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Derive the referenced items' summaries on every serialization and
       strip them again on save (block add-on contract §5.3): the editor
       canvas and the public renderer read the same `items`, and nothing
       derived is ever persisted. -->
  <subscriber
      factory=".transform.ReferenceListSerializer"
      provides="plone.restapi.interfaces.IBlockFieldSerializationTransformer"
      />
  <subscriber
      factory=".transform.ReferenceListSerializerRoot"
      provides="plone.restapi.interfaces.IBlockFieldSerializationTransformer"
      />
  <subscriber
      factory=".transform.ReferenceListDeserializer"
      provides="plone.restapi.interfaces.IBlockFieldDeserializationTransformer"
      />
  <subscriber
      factory=".transform.ReferenceListDeserializerRoot"
      provides="plone.restapi.interfaces.IBlockFieldDeserializationTransformer"
      />

  <!-- Serves the committed editor bundle and its scope-wrapped sheet as
       ++plone++collective.blicca.referencelist/... (block add-on contract
       §3.1). `type="plone"`, never ++resource++: a second URL for the same
       module means a second React inside Plate. -->
  <plone:static
      name="collective.blicca.referencelist"
      type="plone"
      directory="static"
      />

  <genericsetup:importStep
      name="collective.blicca.referencelist-uninstall"
      title="Collective Blicca Referencelist uninstall"
      description="Uninstall collective.blicca.referencelist"
      handler="collective.blicca.referencelist.setuphandlers.uninstall"
      />

  <!-- Keep the uninstall profile out of the Add-ons control panel. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="collective.blicca.referencelist-hiddenprofiles"
      />

  <include package=".views" />

  <include package=".upgrades" />

</configure>
