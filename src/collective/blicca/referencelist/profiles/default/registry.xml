<?xml version="1.0" encoding="utf-8"?>
<registry>

  <!-- The one IAuroraBlockAddon record for the one block this package ships
       (block add-on contract §3.2). Discovery is per site: without the record
       nothing loads the editor half, however correct the JS is.

       Not a `plone.bundles` record: a bundle emits a classic script, so the
       bundle's bare `react` / `platejs` imports would miss the import map
       `@@aurora-edit` emits and a second React would load. -->
  <records
      interface="plone.blicca.auroraeditor.interfaces.IAuroraBlockAddon"
      prefix="plone.blicca.auroraeditor.blockaddons/collective.blicca.referencelist.referencelist"
      >

    <!-- `++plone++`, never `++resource++`: two URLs for one module means two
         Reacts. The directory is the `plone:static` node in configure.zcml;
         the two spellings stay in lockstep. -->
    <value key="bundle">++plone++collective.blicca.referencelist/referencelist-block.js</value>

    <!-- The scope-wrapped sheet that dresses both surfaces (§6). -->
    <value key="css">++plone++collective.blicca.referencelist/referencelist-block.css</value>

    <!-- Diagnostics and insert-gating, never dispatch. -->
    <value key="types">
      <element>plone-collective.referencelist</element>
    </value>

    <value key="enabled">True</value>
    <value key="weight">100</value>
  </records>

</registry>
