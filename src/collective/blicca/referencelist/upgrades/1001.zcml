<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.referencelist">

  <genericsetup:registerProfile
      name="1001"
      title="collective.blicca.referencelist: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.blicca.referencelist:default">

    <!-- Only the changed value, not a copy of the default registry.xml: the
         records import keeps every other field of the existing record. -->
    <genericsetup:upgradeDepends
        title="Declare block-api 2.0 on the reference list block record"
        description="The Plate 53 host stamps block-api 2.0; a 1.x declaration is skipped."
        import_profile="collective.blicca.referencelist.upgrades:1001"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
