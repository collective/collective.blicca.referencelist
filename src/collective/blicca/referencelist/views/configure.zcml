<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="collective.blicca.referencelist">

  <browser:page
      name="aurora-block-referencelist"
      for="*"
      class=".reference_list_block_view.ReferenceListBlockView"
      template="reference_list_block_view.pt"
      permission="zope2.View"
      layer="collective.blicca.referencelist.interfaces.ICollectiveBliccaReferencelistLayer"
      />

  <browser:page
      name="aurora-referencelist"
      for="*"
      class=".reference_list_view.ReferenceListView"
      template="reference_list_view.pt"
      permission="zope2.View"
      layer="collective.blicca.referencelist.interfaces.ICollectiveBliccaReferencelistLayer"
      />

  <browser:page
      name="aurora-referencelist-item"
      for="*"
      class=".reference_list_item_view.ReferenceListItemView"
      template="reference_list_item_view.pt"
      permission="zope2.View"
      layer="collective.blicca.referencelist.interfaces.ICollectiveBliccaReferencelistLayer"
      />

</configure>
