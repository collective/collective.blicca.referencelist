<div xmlns:tal="http://xml.zope.org/namespaces/tal"
     tal:attributes="class view/css_class"
     tal:define="items view/rendered_items">
  <!--! The same anatomy the React view (bundle-src/src/referencelist/
        ReferenceListView.tsx) emits: one scope-wrapped stylesheet dresses the
        canvas and the public page. An empty list renders the headline alone;
        the editor canvas is where "no references yet" is said. -->
  <tal:headline tal:condition="view/headline">
    <h2 class="headline"
        tal:condition="python: view.headline_tag == 'h2'"
        tal:content="view/headline">headline</h2>
    <h3 class="headline"
        tal:condition="python: view.headline_tag == 'h3'"
        tal:content="view/headline">headline</h3>
  </tal:headline>
  <div class="referencelist-items" tal:condition="items">
    <tal:item tal:repeat="item items"
              tal:replace="structure item" />
  </div>
</div>
